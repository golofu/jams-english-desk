# --- Server only (Netlify env vars / .env.local for dev) ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Before Supabase login exists: a shared passcode the app asks for once per device.
# Without Supabase AND without this, production AI endpoints stay closed.
APP_PASSCODE=
# With Supabase: only this Google account may use the AI endpoints (Jam's email). Required.
ALLOWED_EMAIL=

# --- Browser (optional: enables Google login + sync). Leave empty for Local mode. ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Same values for the server to verify logins
SUPABASE_URL=
SUPABASE_ANON_KEY=
