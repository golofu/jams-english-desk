{
  "name": "english-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"wrangler dev --port 8787\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "node dev/check-echo-gate.mjs && node dev/check-merge.mjs",
    "db:migrate": "wrangler d1 migrations apply english-desk --remote",
    "db:migrate:local": "wrangler d1 migrations apply english-desk --local"
  },
  "dependencies": {
    "@google/genai": "^2.29.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.154.0"
  }
}
